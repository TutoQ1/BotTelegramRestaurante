<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <connectionStrings>
        <!--
          PostgreSQL del restaurante (instancia de OCI, Ubuntu 22.04 / PostgreSQL 14).
          Guía completa (SSL, migración de los .txt, consultas): db/README.md

          SSL Mode=Require cifra la conexión sin validar el certificado del servidor
          (el servidor usa un certificado autofirmado y la IP no coincide con el CN).
          Si algún día cargas la CA del servidor, cambia a VerifyFull y quita
          Trust Server Certificate.

          Importante: el servidor está en UTC y el restaurante en UTC-5. La aplicación
          es la única que pone la hora (DateTime.Now) y la base no usa now(); por eso
          los avisos no se desfasan. Ver db/README.md.
        -->
        <add name="Restaurante"
             connectionString="Host=157.137.206.223;Port=5432;Database=restaurante;Username=postgres;Password=Holasoytuto1;SSL Mode=Require;Trust Server Certificate=true;Timeout=15;Command Timeout=30;Pooling=true;Maximum Pool Size=10"
             providerName="Npgsql" />
    </connectionStrings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>
